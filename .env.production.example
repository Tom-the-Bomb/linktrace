
# a hostname for automatic HTTPS, or ":80" for plain HTTP behind a TLS terminator. A proxy
# on a public address must be added to trusted_proxies in the Caddyfile, or visitors share
# one rate limit.
DOMAIN=
ACME_EMAIL=

# public origin baked into canonical/og:url, robots.txt and sitemap.xml; blank keeps the default
VITE_SITE_URL=

MYSQL_ROOT_PASSWORD=CHANGE_ME_root
MYSQL_DATABASE=linktrace
MYSQL_USER=linktrace
MYSQL_PASSWORD=

RABBITMQ_USER=linktrace
RABBITMQ_PASS=

WORKER_COUNT=
MAX_PAGES=
ANON_MAX_PAGES=
MAX_DEPTH=
MAX_PER_CATEGORY=
RATE_PER_MIN=
SHARD_COUNT=
