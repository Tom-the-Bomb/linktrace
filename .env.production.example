
# Caddy site address: a hostname for automatic HTTPS, or ":80" to serve plain HTTP
# (e.g. when TLS is terminated upstream).
DOMAIN=
ACME_EMAIL=

# Public origin, used for canonical/og:url and baked into robots.txt + sitemap.xml at build.
# Leave blank to keep the default; set it when deploying to your own domain.
VITE_SITE_URL=

MYSQL_ROOT_PASSWORD=CHANGE_ME_root
MYSQL_DATABASE=linktrace
MYSQL_USER=linktrace
MYSQL_PASSWORD=

RABBITMQ_USER=linktrace
RABBITMQ_PASS=

WORKER_COUNT=
MAX_PAGES=
MAX_DEPTH=
MAX_PER_CATEGORY=
RATE_PER_MIN=
