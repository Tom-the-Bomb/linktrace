FROM node:22-alpine AS build
WORKDIR /app

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./
ARG VITE_SITE_URL=https://linktrace.tomthebomb.dev
RUN npm run build

# index.html, robots.txt and sitemap.xml hardcode the origin, so it's rewritten here for other
# domains
RUN find dist -type f \( -name '*.html' -o -name '*.xml' -o -name '*.txt' \) \
      -exec sed -i "s|https://linktrace.tomthebomb.dev|${VITE_SITE_URL}|g" {} \;

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
COPY Caddyfile /etc/caddy/Caddyfile
